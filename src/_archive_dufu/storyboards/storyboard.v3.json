  "narration": [],
  "texts": {
    "s01_main": "杜甫，字子美，本襄阳人，后徙河南巩县。",
    "s01_source": "——《旧唐书·杜甫传》",
    "s02_a": "会当凌绝顶",
    "s02_b": "一览众山小",
    "s02_note": "客吴越、齐赵间",
    "s02_year": "开元二十四年",
    "s03_left": "朱门酒肉臭",
    "s03_right": "路有冻死骨",
    "s03_a": "所愧为人父，无食致夭折。",
    "s03_b": "穷年忧黎元，叹息肠内热。",
    "s04_a": "安得广厦千万间",
    "s04_b": "大庇天下寒士俱欢颜",
    "s04_c": "风雨不动安如山",
    "s04_oath": "呜呼！何时眼前突兀见此屋，吾庐独破受冻死亦足！",
    "s05_a": "无边落木萧萧下",
    "s05_b": "不尽长江滚滚来",
    "s05_note": "万里悲秋常作客，百年多病独登台。",
    "s06_a": "星垂平野阔",
    "s06_b": "月涌大江流",
    "s06_note": "飘飘何所似，天地一沙鸥。",
    "s07_stele": [
      "举进士不中第，困长安。",
      "自鄜州羸服欲奔行在，为贼所得。",
      "寓居成州同谷县，自负薪采稆。",
      "儿女饿殍者数人。",
      "扁舟下荆、楚间，竟以寓卒。"
    ],
    "s07_main": "数尝寇乱，挺节无所污。",
    "s07_sub": "默思失业徒，因念戍卒苦。",
    "s08_main": "李杜文章在，光焰万丈长。",
    "s08_note": "诗人以来，未有如子美者。",
    "s08_note_src": "——元稹《杜君墓系铭》",
    "s08_cards": ["春望", "石壕吏", "茅屋", "登高"],
    "s09_a": "战血流依旧",
    "s09_b": "军声动至今",
    "s09_seal": "诗史",
    "s09_note": "情不忘君，人怜其忠云。",
    "s09_note_src": "——《新唐书·杜甫传》"
  }
}
