    "react-dom": "19.3.1",
    "remotion": "4.0.537",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.537",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
