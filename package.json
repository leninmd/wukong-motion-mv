{
  "name": "wukong-motion-mv",
  "version": "0.1.0",
  "private": true,
  "description": "《孙悟空：金猴奋起千钧棒》— deterministic code-driven lyric MV built with Remotion.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts WukongPrologue out/wukong-prologue.mp4",
    "still": "remotion still src/index.ts WukongPrologue out/wukong-poster.png",
    "still:senbon": "remotion still src/index.ts WukongClimaxSegment out/v8_blender_check_f085.png --frame=85",
    "render:senbon": "remotion render src/index.ts WukongClimaxSegment out/senbon_v8_blender.mp4 --concurrency=2",
    "blender:shot1": "blender -b -P scripts/blender/b_shot1_cudgel_shield.py -- --all --frames-dir out/blender_frames/shot1",
    "blender:shot2": "blender -b -P scripts/blender/b_shot2_lingxiao_collapse.py -- --all --frames-dir out/blender_frames/shot2",
    "blender:shot3": "blender -b -P scripts/blender/b_shot3_mountain_chains.py -- --all --frames-dir out/blender_frames/shot3",
    "blender:shot4": "blender -b -P scripts/blender/b_shot4_verdict_abyss.py -- --all --frames-dir out/blender_frames/shot4",
    "assets:wukong": "python scripts/build_wukong_assets.py"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/media-utils": "4.0.537",
    "@remotion/motion-blur": "4.0.537",
    "@remotion/three": "4.0.537",
    "postprocessing": "6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.537",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  }
}
